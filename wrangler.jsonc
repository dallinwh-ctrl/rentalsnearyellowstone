{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rentalsnearyellowstone",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Keep the free *.workers.dev address on so the site can be previewed before the real domain points here.
  "workers_dev": true,
  "preview_urls": true,
  // The real domain. Deploys attach these as Worker custom domains (Cloudflare makes the DNS records and SSL).
  "routes": [
    { "pattern": "rentalsnearyellowstone.com", "custom_domain": true },
    { "pattern": "www.rentalsnearyellowstone.com", "custom_domain": true }
  ],
  // Builds the static pages before every deploy. With the HOSPITABLE_TOKEN build variable set,
  // pages get live photos and reviews; without it they use sample data.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Every request goes through the Worker first so the bare domain can 301 to www.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
